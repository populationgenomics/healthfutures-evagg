Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.7.19-python3.12-bookworm-slim

%files
    ../pyproject.toml /app/
    ../uv.lock /app/
    ../README.md /app/
    ../lib /app/lib

%post
    cd /app
    
    # Fix permissions for files copied in %files section
    chmod -R a+rX /app

    # Export dependencies to requirements.txt and install system-wide to use system certs
    uv export --frozen --no-hashes --no-dev -o requirements.txt && \
        uv pip install --system -r requirements.txt && \
        uv pip install --system -e .
